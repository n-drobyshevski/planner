<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: paints warm paper / charcoal before Compose draws,
         so there is no white flash. Edge-to-edge is enabled in MainActivity.
         AppCompat, as the activities are AppCompatActivity (the member's
         language below Android 13); DayNight picks light or dark from the
         night configuration, as values / values-night did. -->
    <style name="Theme.Planr" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/planr_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
