            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_preview_month"
            android:textColor="@color/planr_widget_ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_year"
            android:textColor="@color/planr_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">
        <TextView style="@style/PlanrWidgetPreviewWeekday" android:text="@string/widget_preview_weekday_1" />
        <TextView style="@style/PlanrWidgetPreviewWeekday" android:text="@string/widget_preview_weekday_2" />
