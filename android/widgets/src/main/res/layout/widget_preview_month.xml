<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (API 31+): a static sketch of MonthWidget.
     RemoteViews-safe views only. Shown once, in the picker, so its view
     count doesn't matter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    tools:ignore="HardcodedText,ContentDescription,TooManyViews">

    <LinearLayout
