<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (API 31+): a static sketch of TasksWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    tools:ignore="UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_tasks_name"
            android:textColor="@color/planr_widget_ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_open_count"
            android:textColor="@color/planr_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout style="@style/PlanrWidgetPreviewRow">
        <ImageView
            style="@style/PlanrWidgetPreviewCheck"
            android:contentDescription="@null" />
        <TextView
            style="@style/PlanrWidgetPreviewTitle"
            android:text="@string/widget_preview_task_1" />
        <TextView
            style="@style/PlanrWidgetPreviewDue"
            android:text="@string/widget_due_today" />
    </LinearLayout>

    <LinearLayout style="@style/PlanrWidgetPreviewRow">
        <ImageView
            style="@style/PlanrWidgetPreviewCheck"
            android:contentDescription="@null" />
        <TextView
            style="@style/PlanrWidgetPreviewTitle"
            android:text="@string/widget_preview_task_2" />
        <TextView
            style="@style/PlanrWidgetPreviewDue"
            android:text="@string/widget_due_tomorrow" />
    </LinearLayout>

    <LinearLayout style="@style/PlanrWidgetPreviewRow">
        <ImageView
            style="@style/PlanrWidgetPreviewCheck"
            android:contentDescription="@null" />
        <TextView
            style="@style/PlanrWidgetPreviewTitle"
            android:text="@string/widget_preview_task_3" />
    </LinearLayout>
</LinearLayout>
