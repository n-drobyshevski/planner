<?xml version="1.0" encoding="utf-8"?>
<!-- Widget copy. Every name is prefixed `widget_` so it can't collide with
     other modules once resources merge into the app. -->
<resources>
    <!-- Widget picker -->
    <string name="widget_today_name">Today</string>
    <string name="widget_today_description">Today’s events for both of you</string>
    <string name="widget_tasks_name">Tasks</string>
    <string name="widget_tasks_description">Open tasks, with a checkbox to complete them</string>
    <string name="widget_quickadd_name">Quick add</string>
    <string name="widget_quickadd_description">Add a task or an event in one tap</string>
    <string name="widget_week_name">Week</string>
    <string name="widget_week_description">This week, day by day, for both of you</string>
    <string name="widget_month_name">Month</string>
    <string name="widget_month_description">The month at a glance, with your events day by day</string>
    <string name="widget_week_grid_name">Week grid</string>
    <string name="widget_week_grid_description">The week in seven columns, with your events day by day</string>

    <!-- Shared states -->
    <string name="widget_sign_in">Sign in</string>
    <string name="widget_open_app">Open Planr</string>
    <string name="widget_unavailable">Couldn’t load. Open the app to refresh.</string>

    <!-- Today -->
    <string name="widget_today_signed_out">Sign in to see your day here.</string>
    <string name="widget_today_empty">Nothing scheduled today</string>
    <string name="widget_untitled_event">Untitled event</string>
    <string name="widget_all_day">All day</string>
    <!-- A timed event that began on an earlier day: "to 10:00". -->
    <string name="widget_until">to %1$s</string>

    <!-- Week -->
    <string name="widget_week_title">This week</string>
    <string name="widget_week_signed_out">Sign in to see your week here.</string>
    <string name="widget_week_previous">Previous week</string>
    <string name="widget_week_next">Next week</string>
    <!-- A day with nothing on it, beside its heading (also read out for a month cell). -->
    <string name="widget_week_free">Free</string>
    <plurals name="widget_week_event_count">
        <item quantity="one">%d event</item>
        <item quantity="other">%d events</item>
    </plurals>

    <!-- Month -->
    <string name="widget_month_signed_out">Sign in to see your month here.</string>
    <string name="widget_month_previous">Previous month</string>
    <string name="widget_month_next">Next month</string>
    <string name="widget_month_add_event">Add event</string>
    <!-- Read out for a week-number cell: "Week 41". -->
    <string name="widget_month_week">Week %1$d</string>
    <!-- More events in a day than fit its cell: "+2". -->
    <string name="widget_month_more">+%1$d</string>

    <!-- Tasks -->
    <string name="widget_tasks_signed_out">Sign in to see your tasks here.</string>
    <string name="widget_tasks_empty">No open tasks</string>
    <string name="widget_untitled_task">Untitled task</string>
    <string name="widget_task_mark_done">Mark “%1$s” done</string>
    <string name="widget_due_today">Today</string>
    <string name="widget_due_tomorrow">Tomorrow</string>
    <plurals name="widget_tasks_open_count">
        <item quantity="one">%d open</item>
        <item quantity="other">%d open</item>
    </plurals>
    <string name="widget_task_complete_failed">Couldn’t complete the task. Check your connection and try again.</string>

    <!-- Quick add -->
    <string name="widget_quickadd_task">+ Task</string>
    <string name="widget_quickadd_event">+ Event</string>

