    <string name="sleep_tab_times">%1$s–%2$s</string>
    <string name="sleep_tab_in_bed">%1$s in bed</string>
    <string name="sleep_tab_asleep">%1$s asleep</string>
    <string name="sleep_tab_not_rated">Not rated</string>
    <string name="sleep_tab_rate">Rate or edit this night</string>
    <string name="sleep_tab_stage_deep">Deep</string>
    <string name="sleep_tab_stage_light">Light</string>
    <string name="sleep_tab_stage_rem">REM</string>
    <string name="sleep_tab_stage_awake">Awake</string>
    <string name="sleep_tab_sr_deep">deep %1$s</string>
    <string name="sleep_tab_sr_light">light %1$s</string>
    <string name="sleep_tab_sr_rem">REM %1$s</string>
    <string name="sleep_tab_sr_awake">awake %1$s</string>
    <!-- A night's spoken summary: "Tue, 6 Oct: 23:40–07:10, 7h 29m in bed, …". -->
    <string name="sleep_tab_sr_night">%1$s: %2$s.</string>
