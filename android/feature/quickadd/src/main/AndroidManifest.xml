<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Hosts the Quick add sheet over the home screen. Launched only by
             our own widget, launcher shortcuts and Quick Settings tile
             (explicit intents, started as this app), so it isn't exported;
             its own empty task affinity keeps it out of the main app's back
             stack. -->
        <activity
            android:name=".QuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Planr.QuickAdd"
            android:windowSoftInputMode="adjustResize" />

        <!-- Text or a link shared from another app opens Quick add on a task,
             prefilled. Only text/plain: a calendar file (text/calendar) still
             goes to the app's .ics import. -->
        <activity-alias
            android:name=".ShareToQuickAddActivity"
            android:exported="true"
            android:targetActivity=".QuickAddActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- The "Add to Planr" Quick Settings tile: opens Quick add on a task.
             Bound only by the system (BIND_QUICK_SETTINGS_TILE). -->
        <service
            android:name=".QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_quick_add"
            android:label="@string/quickadd_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
