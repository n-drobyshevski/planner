# Copy to .env.local and fill in. On Vercel, set the SAME variables under
# Project → Settings → Environment Variables and enable them for ALL
# environments (Production, Preview, Development) — if they're scoped to
# Production only, Preview deploys crash with a 500 from proxy.ts.

# --- Supabase (Project → Settings → API) ---------------------------------
# Public project URL and publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Secret (service-role) key — SERVER ONLY. Bypasses RLS; used by the pre-auth
# PIN lookup and `pnpm seed`. Never prefix with NEXT_PUBLIC_ / expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Public site URL -----------------------------------------------------
# Canonical origin used to build absolute share links (https://planr.page/share/<token>).
# Set this in Vercel PRODUCTION ONLY. Leave it unset for local dev and Preview
# deploys so links fall back to the current host (localhost / the preview URL).
NEXT_PUBLIC_SITE_URL=https://planr.page

# --- Members ------------------------------------------------------------
# The two members. Each maps to a pre-provisioned Supabase auth user; the
# server signs in with these credentials once the member's passkey/passphrase
# is verified. NAME is the nickname seeded for that member.
#
# The passwords are the REAL perimeter: Supabase's password grant is publicly
# reachable with the anon key, bypassing the app's login form, passkeys, and
# throttles entirely. Give each member a UNIQUE random password of at least 16
# chars (e.g. `openssl rand -base64 24`) and a non-guessable email. Production
# refuses the placeholder below. Rotating a password in Supabase invalidates
# that member's sessions — the "revoke everything" lever.
MEMBER_A_NAME=Alex
MEMBER_A_EMAIL=alex@example.com
MEMBER_A_PASSWORD=replace-with-a-strong-unique-random-password

MEMBER_B_NAME=Sam
MEMBER_B_EMAIL=sam@example.com
MEMBER_B_PASSWORD=replace-with-a-strong-unique-random-password

# --- WebAuthn (passkeys) -------------------------------------------------
# Optional. When unset, the relying party (rpID/origin) is derived from the
# request's Host/proto headers, which is correct for localhost and a normal
# Vercel deploy. Set BOTH to pin the relying party in production, or when the
# app sits behind a proxy that rewrites Host. rpID is the registrable domain
# (no scheme/port); origin is the full scheme+host the browser reports.
# WEBAUTHN_RP_ID=planr.page
# WEBAUTHN_ORIGIN=https://planr.page

# --- MCP server (Claude connector) --------------------------------------
# Exposes calendar/tasks/insights to Claude (claude.ai, Desktop, Code) over a
# remote MCP endpoint at /api/mcp, OAuth-secured by Supabase's OAuth server.
# Off by default; flip to "true" to mount the endpoint.
MCP_ENABLED=false
# Redis connection (TCP, redis:// or rediss://) — REQUIRED when MCP_ENABLED.
# mcp-handler uses it for streamable-HTTP session state across serverless
# instances. On Vercel, add the Upstash/Redis Marketplace integration (fra1) and
# it sets REDIS_URL automatically; locally use a dev Upstash URL or
# `redis://localhost:6379`.
REDIS_URL=
# Optional explicit public origin for OAuth resource metadata. Defaults to the
# request origin (NEXT_PUBLIC_SITE_URL in prod). Set only if behind a proxy that
# strips the standard forwarding headers.
# MCP_RESOURCE_URL=https://planr.page
# "Claude only" guard: comma-separated redirect hosts allowed to be authorized.
# Default "claude.ai" covers claude.ai web/Desktop/mobile/Cowork. Use "*" to
# allow any client (relies on the consent screen alone).
# MCP_ALLOWED_REDIRECT_HOSTS=claude.ai
# Allow RFC 8252 loopback redirects (localhost/127.0.0.1) — needed for Claude
# Code, but also permits any native client. Off by default.
# MCP_ALLOW_LOOPBACK_REDIRECT=false
